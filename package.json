{
  "name": "taskr",
  "version": "1.0.0",
  "description": "Task management REST API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:seed": "node src/db/seed.js",
    "db:reset": "rm -f taskr.db && node src/db/seed.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/*.test.js"
    ]
  }
}
